{
  "datasets": [
    {
      "name": "2744a32b",
      "displayName": "Manufacturing Revenue Margins Summary Report",
      "queryLines": [
        "select round(sum(total_revenue),2) as total_revenue,\r\n",
        "round(avg(margin_pct),2) as avg_margin_pct,\r\n",
        "count(distinct quote_id) as total_quotes\r\n",
        "from default.gold_manufacturing_margins;\r\n",
        "\r\n"
      ]
    },
    {
      "name": "b03ecdc5",
      "displayName": "Product Category Revenue and Margin Overview",
      "queryLines": [
        "select product_category, \r\n",
        "round(sum(total_revenue),2) as category_revenue,\r\n",
        "round(avg(margin_pct),2) as avg_margin_pct\r\n",
        "from default.gold_manufacturing_margins\r\n",
        "group by product_category\r\n",
        "order by category_revenue desc;"
      ]
    },
    {
      "name": "a19991dc",
      "displayName": "Gold Margin Anomaly Counts by Reason Summary",
      "queryLines": [
        "SELECT \r\n",
        "    anomaly_reason,\r\n",
        "    COUNT(*) AS anomaly_count\r\n",
        "FROM default.gold_margin_anomalies\r\n",
        "GROUP BY anomaly_reason;"
      ]
    }
  ],
